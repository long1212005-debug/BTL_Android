<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Btl_Android">
        
        <!-- Màn hình cào dữ liệu tự động trở thành màn hình chính -->
        <activity
            android:name=".controller.LayDuLieuWebViewActivity"
            android:exported="true"
            android:label="Ứng dụng của Vduc và Hthinh">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".controller.MainActivity"
            android:exported="false"
            android:label="Trang chủ" />
            
        <activity android:name=".controller.LayDiemTPWebViewActivity" android:exported="false" />
        <activity android:name=".controller.ThongKe" android:exported="false" />
        <activity android:name=".controller.LoTrinhHocTapActivity" android:exported="false" />
        <activity android:name=".controller.ChiTietKyHocActivity" android:exported="false" />
        <activity android:name=".controller.CongCuActivity" android:exported="false" />
        <activity android:name=".controller.TinhDiemCanThiActivity" android:exported="false" />
    </application>

</manifest>